# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION BEGIN
PassengerAppRoot "/home/jamranqu/public_html/Backend"
PassengerBaseURI "/"
PassengerNodejs "/home/jamranqu/nodevenv/public_html/Backend/18/bin/node"
PassengerAppType node
PassengerStartupFile server.js
# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION END

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# 1. Do NOT rewrite API routes - pass directly to Node.js Passenger
RewriteCond %{REQUEST_URI} ^/api/ [NC]
RewriteRule .* - [L]

# 2. Specifically map /courses to courses.html
RewriteRule ^courses/?$ courses.html [L]

# 3. Existing static files (css, js, images, html)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 4. Clean URLs (/about -> about.html)
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.*)$ $1.html [L]

# 5. Courses Clean URLs (/courses/slug -> courses/slug.html)
RewriteCond %{DOCUMENT_ROOT}/courses/$1.html -f
RewriteRule ^courses/(.*)$ courses/$1.html [L]
</IfModule>
