# ============================================================
# Jamaran Online Quran Academy — Environment Variables
# Copy this file to .env and fill in your real values
# ============================================================

# --- Database (cPanel MySQL) ---
DB_HOST=localhost
DB_USER=your_cpanel_db_user
DB_PASSWORD=your_cpanel_db_password
DB_NAME=your_cpanel_db_name

# --- Server ---
PORT=3000

# --- Authentication (must be at least 32 chars, change before deploy!) ---
JWT_SECRET=change_this_to_a_long_random_secret_at_least_32_chars

# --- Email Settings (Gmail App Password) ---
EMAIL_USER=your-gmail@gmail.com
EMAIL_APP_PASSWORD=your-16-char-gmail-app-password
ADMIN_EMAIL=your-email@gmail.com

# --- Admin Default Credentials (used by: node seed_admin.js) ---
ADMIN_DEFAULT_USER=admin
ADMIN_DEFAULT_PASSWORD=Admin@Jamaran2026!
